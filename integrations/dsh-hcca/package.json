{
  "name": "@hcca/dsh-hcca",
  "version": "0.2.1",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "description": "HCCA collaboration view (conversation tab) + Python sidecar for DSH",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./preset-tools": "./preset-tools.mjs",
    "./preset-filter": "./preset-filter.mjs"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-session"
      ],
      "platform": "web"
    }
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "preset-tools.mjs",
    "preset-filter.mjs",
    "hcca-preset.patch.yml",
    "install.py"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2"
  }
}
